{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalimba Man",
  "version": "0.1.0",
  "identifier": "com.kalimbaman.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kalimba Man",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "shortDescription": "Learn kalimba songs by playing along",
    "longDescription": "Import a tab from kalimbatabs.net and watch numbered notes fall onto a drawing of your kalimba."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMTJGMDVERDE1QjYwNgpSV1FHdGhYZEJTL2hCQ1ZFUW9IeVZrYU5WWDlWcEdQWXBCeGwzdDV5V0ViQnhTUUM2K3RQUjNKQQo=",
      "endpoints": [
        "https://github.com/hjzaradich/kalimba-man-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
